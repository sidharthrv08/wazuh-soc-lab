<!-- Wazuh Custom Detection Rules (local_rules.xml) -->
<!-- Location on Wazuh Manager: /var/ossec/etc/rules/local_rules.xml -->

<group name="linux,kali,soc_lab,">

  <!-- ============================================================== -->
  <!-- 1. DETECTING SUSPICIOUS USER ADDITION VIA FILE INTEGRITY (FIM) -->
  <!-- ============================================================== -->
  <rule id="100001" level="10">
    <if_sid>550</if_sid>
    <match>/etc/passwd|/etc/shadow</match>
    <description>SOC Lab Alert: Critical system authentication file modified (/etc/passwd or /etc/shadow)</description>
    <mitre>
      <id>T1078</id>
      <id>T1098</id>
    </mitre>
    <info type="text">A critical credential file has been altered. This often indicates account creation or backdoor placement.</info>
  </rule>

  <!-- ============================================================== -->
  <!-- 2. SSH BRUTE FORCE ATTACK CORRELATION                         -->
  <!-- ============================================================== -->
  <rule id="100002" level="12" frequency="6" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SOC Lab Alert: SSH Brute-Force Attack detected against endpoint (Multiple invalid user login attempts)</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1110.003</id>
    </mitre>
  </rule>

  <!-- ============================================================== -->
  <!-- 3. DETECTING SUSPICIOUS SUDO PRIVILEGE ESCALATION PROBES       -->
  <!-- ============================================================== -->
  <rule id="100003" level="8" frequency="3" timeframe="60">
    <if_matched_sid>5404</if_matched_sid>
    <description>SOC Lab Alert: Repeated failed sudo attempts detected for a non-root user (Potential Privilege Escalation probe)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <!-- ============================================================== -->
  <!-- 4. REVERSE SHELL / NETCAT LISTENER DETECTION VIA AUDITD       -->
  <!-- ============================================================== -->
  <rule id="100004" level="13">
    <if_sid>80700</if_sid>
    <match>nc -e|ncat -e|netcat -e|bash -i &gt;&amp; /dev/tcp</match>
    <description>SOC Lab Critical: Interactive Reverse Shell command line pattern executed on monitored host</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1071</id>
    </mitre>
  </rule>

  <!-- ============================================================== -->
  <!-- 5. DETECTING CLEARING OF LINUX COMMAND HISTORY (DEFENSE EVASION) -->
  <!-- ============================================================== -->
  <rule id="100005" level="9">
    <if_sid>80700</if_sid>
    <match>history -c|rm -f ~/.bash_history|unset HISTFILE</match>
    <description>SOC Lab Alert: Adversary command history clearing detected (Defense Evasion)</description>
    <mitre>
      <id>T1070.003</id>
    </mitre>
  </rule>

</group>
