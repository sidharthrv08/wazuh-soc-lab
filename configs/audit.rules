# Linux Audit Daemon (auditd) Rules for Wazuh SOC Telemetry
# File location on Kali Endpoint: /etc/audit/rules.d/wazuh-soc.rules

## Remove any existing rules
-D

## Buffer Size (high volume logging)
-b 8192

## Failure mode: 1 = printk failure messages
-f 1

## 1. Monitor Command Execution (execve) for 64-bit and 32-bit systems
-a always,exit -F arch=b64 -S execve -k audit-wazuh-c
-a always,exit -F arch=b32 -S execve -k audit-wazuh-c

## 2. Monitor Modification of Authentication & Account Files
-w /etc/passwd -p wa -k identity_modification
-w /etc/shadow -p wa -k identity_modification
-w /etc/group -p wa -k identity_modification
-w /etc/gshadow -p wa -k identity_modification
-w /etc/sudoers -p wa -k sudoers_modification
-w /etc/sudoers.d/ -p wa -k sudoers_modification

## 3. Monitor Network Configuration Changes
-w /etc/hosts -p wa -k network_mod
-w /etc/network/ -p wa -k network_mod
-w /etc/resolv.conf -p wa -k network_mod

## 4. Monitor Suspicious Privilege Escalation Binaries
-w /bin/su -p x -k priv_escalation
-w /usr/bin/sudo -p x -k priv_escalation
-w /usr/bin/chsh -p x -k priv_escalation

## 5. Monitor Crontab and Scheduled Tasks (Persistence)
-w /etc/cron.allow -p wa -k cron_persistence
-w /etc/cron.deny -p wa -k cron_persistence
-w /etc/cron.d/ -p wa -k cron_persistence
-w /etc/cron.daily/ -p wa -k cron_persistence
-w /etc/crontab -p wa -k cron_persistence
-w /var/spool/cron/crontabs/ -p wa -k cron_persistence
